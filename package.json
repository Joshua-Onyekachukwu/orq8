{
  "name": "orq8",
  "private": true,
  "version": "0.1.0",
  "description": "ORQ8 — The AI Organization Operating System (Phase 1: Foundation)",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @orq8/api dev",
    "dev:api": "pnpm --filter @orq8/api dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @orq8/db generate",
    "db:migrate": "pnpm --filter @orq8/db migrate",
    "db:seed": "pnpm --filter @orq8/db seed",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}

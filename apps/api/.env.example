# ORQ8 API — copy to apps/api/.env (never commit real values; .gitignore covers it)
# Docs: 37 (security) · 42 (infrastructure) · 23 (provider keys) · 51 (env setup)

NODE_ENV=development
PORT=3001
LOG_LEVEL=info

# Database — Postgres 16 + pgvector via infra/docker-compose.yml
DATABASE_URL=postgres://orq8:orq8_dev_only_change_me@localhost:5432/orq8

# Secrets (docs/37) — generate strong values, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change_me_32_bytes_hex
ENCRYPTION_KEY=change_me_32_bytes_hex   # encrypts provider API keys at rest (23)

# Object storage — MinIO locally (S3-compatible; swap endpoint for R2/S3 later, docs/42.2)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=orq8_minio
S3_SECRET_KEY=orq8_dev_only_minio
S3_BUCKET=orq8
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# Model gateway — LiteLLM (docs/22); local models via Ollama (docs/51.3)
LITELLM_BASE_URL=http://localhost:4000
LITELLM_MASTER_KEY=sk-orq8-dev-litellm
OLLAMA_BASE_URL=http://localhost:11434

# Web (CORS)
ALLOWED_ORIGINS=http://localhost:3000

# Observability — pino + OpenTelemetry (docs/39); Langfuse collector optional (infra obs profile)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

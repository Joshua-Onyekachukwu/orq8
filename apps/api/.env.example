# ORQ8 API Environment Variables

# Runtime
# Setting NODE_ENV to production makes the boot guard below refuse the
# dev-only SESSION_SECRET / ENCRYPTION_KEY values.
NODE_ENV=development
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Database
DATABASE_URL=postgresql://orq8:orq8_dev_only_change_me@localhost:5432/orq8

# Session
SESSION_SECRET=change-me-in-production

# Encryption (32-byte hex key for provider key encryption)
ENCRYPTION_KEY=change-me-in-production-hex-32-bytes!!
# Wrapping-key version stamp recorded with each encrypted value (docs/23.5).
# Change it only when rotating the wrapping key.
ENCRYPTION_KEY_KID=v1

# S3/MinIO
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=orq8_minio
S3_SECRET_KEY=orq8_dev_only_minio
S3_BUCKET=orq8
# S3_REGION=auto (Cloudflare R2 uses 'auto'; omit for MinIO)
# LOCAL_STORAGE_DIR=./.orq8-files (used when no bucket is configured)

# LiteLLM — DEVELOPMENT ONLY. Never set this on a production host: it is tried
# last, so a stray local URL cannot decide what a production request does.
LITELLM_BASE_URL=http://localhost:4000
LITELLM_MASTER_KEY=sk-orq8-dev-litellm

# OpenRouter — PRIMARY provider (docs/22.9). One credential fronts many vendors
# (Claude, GPT-4o, Gemini, ...), so a pinned model id is honoured exactly and an
# unpinned call has one predictable destination. Tried first for all Executive
# Agent / task execution calls.
# Multi-key pool: extra keys (comma-separated) are rotated round-robin.
OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_API_KEYS=sk-or-v1-...,sk-or-v1-...,sk-or-v1-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini
# Models tried when OPENROUTER_MODEL fails, before escalating to NVIDIA NIM.
# OPENROUTER_MODEL_FALLBACKS=anthropic/claude-3.5-sonnet,google/gemini-2.0-flash-001

# Job queue (docs/75). 'inline' (default) runs agent work on the request path;
# 'workers' enqueues to the durable agent_jobs table and a background worker
# drains it (retries, backoff, stale-lock reaping). Worker poll interval only
# matters in 'workers' mode.
# JOB_QUEUE_MODE=inline
# JOB_WORKER_INTERVAL_MS=2000

# NVIDIA NIM — FIRST FALLBACK (docs/22.9). Free tier: build.nvidia.com → Get API
# Key (nvapi-...). Used when OpenRouter is not configured or fails.
# Multi-key pool: extra keys (comma-separated) are rotated round-robin across
# concurrent requests and failed over automatically (429 / 401 / 403 / 404).
NVIDIA_API_KEY=nvapi-...
# NVIDIA_API_KEYS=nvapi-...,nvapi-...,nvapi-...
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Default model must be one your account can actually serve (probe with a
# chat completion; GET /v1/models lists the catalog, not your entitlement).
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
# Models tried when NVIDIA_MODEL 404s for the account (entitlement varies per
# model). Comma-separated; walked before escalating to LiteLLM.
# All must be confirmed working for your account before use.
NVIDIA_MODEL_FALLBACKS=nvidia/nemotron-3.5-lightning-30b-a3b,nvidia/nemotron-3-nano-omni-30b-a3b-reasoning,meta/llama-3.2-11b-vision-instruct

# SerpAPI — real web search for agent research tools
# SERPAPI_KEY=your-serpapi-key-here

# Ollama — DEVELOPMENT ONLY. Local models, no API key needed. Always last in the
# chain, so being configured locally can never lead a production request.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# LLM request timeouts (docs/22) — unprovisioned provider functions sometimes
# HANG instead of returning 404. LLM_HEADERS_TIMEOUT_MS aborts requests the
# server never answers (keeps a dead model from stalling the chain);
# LLM_TIMEOUT_MS is the overall budget including the body read (generous so
# slow-but-legitimate long generations still complete).
# LLM_HEADERS_TIMEOUT_MS=30000
# LLM_TIMEOUT_MS=90000

# Platform-admin bootstrap: comma-separated emails allowed into /v1/admin/* and
# /admin without a DB write. Use to promote the first operator account; after
# that, prefer setting users.platform_role = 'admin' in the DB (migration 0011).
# PLATFORM_ADMIN_EMAILS=founder@orq8.ai

# GitHub OAuth (Task 1) — create a GitHub OAuth App:
#   Settings → Developer settings → OAuth Apps → New OAuth App
# Authorization callback URL: <APP_URL>/api/integrations/callback/github
# Server-side only — never expose the secret to the browser.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google (Gmail) OAuth — same server-side pattern as GitHub.
# Callback URL: <APP_URL>/api/integrations/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# APP_URL is also required for the OAuth redirect URI validation.

# Embeddings (Phase 9 — semantic company memory, ADR-012).
# Any OpenAI-compatible /embeddings endpoint. Local default: LiteLLM → Ollama
# nomic-embed-text (768-dim). Unset = memory search falls back to keyword (ilike)
# — writes never fail without embeddings.
# EMBEDDING_BASE_URL=http://localhost:4000
# EMBEDDING_MODEL=nomic-embed-text
# EMBEDDING_API_KEY=

# Webhook secrets are generated per-org at runtime (POST /v1/integrations/:id/webhook-secret)
# and stored encrypted — no environment variable needed. Cron hooks use this
# shared token (also gates /v1/internal/events/process-pending,
# /v1/internal/memory/consolidate, /v1/internal/briefings/daily).
# Unset disables the internal endpoints entirely (dev uses the inline timer).
# INTERNAL_TOKEN=<random ≥32 chars>

# Observability (docs/39) — OTLP collector for traces and metrics. Unset = no export.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Email transport. RESEND_API_KEY (preferred) or SMTP_*; with neither set the
# app runs in dev mode and logs mail instead of sending it.
# RESEND_API_KEY=re_...
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=...
EMAIL_FROM=ORQ8 <founder@orq8.ai>

# Redis — cross-instance cache, rate limiting and idempotency (docs/42).
# Unset = in-process limiter, which is correct for one instance and wrong for many.
# REDIS_URL=redis://localhost:6379

# Stripe billing. Secret key plus one price id per plan and interval; the
# webhook secret verifies /v1/billing/webhook. Unset = billing endpoints reply
# that billing is not configured, and credits still work.
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_FOUNDER_MONTHLY=price_...
# STRIPE_PRICE_FOUNDER_ANNUAL=price_...
# STRIPE_PRICE_TEAM_MONTHLY=price_...
# STRIPE_PRICE_TEAM_ANNUAL=price_...
# STRIPE_PRICE_COMPANY_MONTHLY=price_...
# STRIPE_PRICE_COMPANY_ANNUAL=price_...

# The app's own public URL. Required for OAuth redirect-URI validation, for
# links in verification and invitation email, and for Stripe return URLs.
# APP_URL=https://app.orq8.ai

# Business Import (Phase 10) — 'true' lets the import pipeline refine extracted
# facts with the configured model. It never invents facts; unset or false keeps
# extraction strictly to what the source documents say.
# BUSINESS_IMPORT_ENRICHMENT=false

# Executive Agent brand name — how the EA introduces itself in conversation.
# EA_DISPLAY_NAME=Atlas

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Port
PORT=3001

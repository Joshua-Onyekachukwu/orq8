# ORQ8 Web (Next.js) — copy to apps/web/.env (never commit real values)
# Docs: 51 (env setup) · 42 (infrastructure)

# Browser-facing API base URL (used by the client)
NEXT_PUBLIC_API_URL=http://localhost:3001

# Server-side API base URL (SSR / server components); must differ in container mode
API_URL=http://localhost:3001

# Session/auth secret shared with the API — use the same value as API SESSION_SECRET
AUTH_SECRET=change_me_32_bytes_hex

# App origin + port
NEXT_PUBLIC_APP_URL=http://localhost:3000
PORT=3000

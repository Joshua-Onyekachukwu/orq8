# ORQ8 Web App Environment Variables

# API URL (server-side, for SSR data fetching)
API_URL=http://localhost:3001

# Public API URL (client-side, if needed)
NEXT_PUBLIC_API_URL=http://localhost:3001

# Registration gate (set to "true" to allow new signups)
REGISTRATION_OPEN=false

# Session secret (for cookie signing in production)
AUTH_SECRET=change-me-in-production

# Node environment
NODE_ENV=development

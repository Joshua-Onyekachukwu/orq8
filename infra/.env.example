# ORQ8 — infra environment (copy to infra/.env and adjust)
# Used by infra/docker-compose.yml for interpolation.
# DEV-ONLY defaults — never reuse in production (docs/42.5, 43).
# Generate strong secrets with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Postgres 16 + pgvector
POSTGRES_USER=orq8
POSTGRES_PASSWORD=orq8_dev_only_change_me
POSTGRES_DB=orq8

# MinIO (S3-compatible object storage)
MINIO_ROOT_USER=orq8_minio
MINIO_ROOT_PASSWORD=orq8_dev_only_minio
MINIO_BUCKET=orq8

# LiteLLM model gateway
LITELLM_MASTER_KEY=sk-orq8-dev-litellm

# Ports (override on conflict; docs/51.6 troubleshooting)
POSTGRES_PORT=5432
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
LITELLM_PORT=4000
OLLAMA_PORT=11434
API_PORT=3001
WEB_PORT=3000
LANGFUSE_PORT=3002

# All-in-one ("app" profile) secrets — required only for `docker compose --profile app up`
SESSION_SECRET=change_me_32_bytes_hex
ENCRYPTION_KEY=change_me_32_bytes_hex

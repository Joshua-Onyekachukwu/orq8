# ORQ8 — infra environment (copy to infra/.env and adjust)
# Used by infra/docker-compose.yml for interpolation.
# DEV-ONLY defaults — never reuse in production (docs/42.5, 43).
# Generate strong secrets with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Postgres 16 + pgvector
POSTGRES_USER=orq8
POSTGRES_PASSWORD=orq8_dev_only_change_me
POSTGRES_DB=orq8

# MinIO (S3-compatible object storage)
MINIO_ROOT_USER=orq8_minio
MINIO_ROOT_PASSWORD=orq8_dev_only_minio
MINIO_BUCKET=orq8

# LiteLLM model gateway
LITELLM_MASTER_KEY=sk-orq8-dev-litellm

# Ports (override on conflict; docs/51.6 troubleshooting)
POSTGRES_PORT=5432
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
LITELLM_PORT=4000
OLLAMA_PORT=11434
API_PORT=3001
WEB_PORT=3000
LANGFUSE_PORT=3002

# All-in-one ("app" profile) secrets — required only for `docker compose --profile app up`
SESSION_SECRET=change_me_32_bytes_hex
ENCRYPTION_KEY=change_me_32_bytes_hex

# NVIDIA NIM — direct LLM provider (free tier at build.nvidia.com, key starts with nvapi-).
# When set, takes priority over LiteLLM for Executive Agent / task execution.
# Multi-key pool: NVIDIA_API_KEYS (comma-separated) adds keys that are rotated
# round-robin and failed over automatically (429 / 401 / 403 / 404).
NVIDIA_API_KEY=nvapi-...
# NVIDIA_API_KEYS=nvapi-...,nvapi-...
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Default model must be one your account can actually serve (entitlement
# varies per account — probe with a chat completion before use).
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
# Models tried when NVIDIA_MODEL 404s for the account (comma-separated),
# walked before escalating to LiteLLM.
NVIDIA_MODEL_FALLBACKS=nvidia/nemotron-3.5-lightning-30b-a3b,nvidia/nemotron-3-nano-omni-30b-a3b-reasoning,meta/llama-3.2-11b-vision-instruct

# Ollama — local model fallback (tried after NVIDIA NIM and LiteLLM).
# Enable by setting OLLAMA_BASE_URL (the infra compose stack maps port 11434).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# LLM request timeouts (docs/22): unprovisioned provider functions sometimes
# HANG instead of returning 404. LLM_HEADERS_TIMEOUT_MS aborts requests the
# server never answers; LLM_TIMEOUT_MS is the overall budget incl. body read.
# LLM_HEADERS_TIMEOUT_MS=30000
# LLM_TIMEOUT_MS=90000

# Platform-admin bootstrap: comma-separated emails allowed into /v1/admin/* and
# /admin without a DB write. Promote the first operator account here, then set
# users.platform_role = 'admin' in the DB (migration 0011) for permanence.
# PLATFORM_ADMIN_EMAILS=founder@orq8.ai

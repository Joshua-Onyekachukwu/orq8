# Dependencies
node_modules/
.pnpm-store/

# Builds
dist/
build/
.next/
out/
*.tsbuildinfo
# Stale committed bundle (untracked 2026-10-13; deploys run tsx src/index.ts).
# Regenerable build output — never commit.
apps/api/api/

# Env / secrets
.env
.env.*
!.env.example

# App internal data (never commit)
.freebuff/

# Vercel CLI/build artifacts
.vercel/

# Landing recovery oracle — local verification material, not part of the codebase
.recovery/

# Reference pack — local only; not part of the codebase
/Trezo/

# Local data volumes (postgres, minio, ollama)
data/
volumes/
pgdata/
# Embedded-Postgres data dirs used by the E2E harnesses and the integration runner.
.auth-e2e-pg/
.rls-e2e-pg/
.integration-suite-pg/
.integration-suite-data/
.vertical-slice-data/
.worker-soak-data/
.ci-lineage-data/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Testing
coverage/
playwright-report/
test-results/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Temporary files
/tmp/
*.tmp
*.bak

# Freebuff artifacts
.freebuff/

.vercel
secrets.env

# Production Supabase credentials for this workspace. Already covered by the
# `.env.*` rule above; named explicitly so the intent survives any change to that
# pattern — a secret key here bypasses RLS on production.
.env.supabase.local

# Migration-parity fingerprints and probes (local evidence, never committed)
.lineage-parity/

# Local review stack data (never committed). One root per stack, scoped by port,
# so two stacks can run side by side without killing each other's database.
.review-stack-data*/
.review-stack.log
.review-stack.err
.review-stack*.log
.review-stack*.err
.supabase-setup.json

# Harness artifacts that carry credentials or captured environment state.
# These sat untracked-but-committable in the repo root (docs/87 §5 item 3), so a
# single `git add -A` would have put a live review session token in a commit.
# Named explicitly rather than by wildcard: `*.txt` would also swallow scratch
# notes a contributor means to keep.
.review-token.txt
.review-kid.txt
.railway-api-env-names.json
all prompt.txt
.dept-e2e-data/

# DR drill artifacts (prod data snapshot + restore scratch)
.dr-backup/
.dr-restore-data/

# Local file-storage fallback (LOCAL_STORAGE_DIR default). Test runs and dev
# servers write real blobs here; never commit them.
.orq8-storage/
**/.orq8-storage/

# ORQ8 — root build context for container images (compose profiles "app").
# The compose build context is the repo root (context: ..), so keep the
# payload minimal: only package manifests, lockfile, and app sources.

node_modules
**/node_modules
.pnpm-store
.git
.gitignore
.github
.freebuff
docs
marketing
tools
infra
data
volumes
pgdata

# Build outputs
dist
build
out
.next
**/.next
*.tsbuildinfo
coverage

# Env / secrets (never bake into images)
.env
.env.*

# NOTE: never ignore asset extensions (*.png, *.jpg, *.svg, ...) here. The web
# app statically imports images (e.g. the navbar logo) and serves
# apps/web/public/images at runtime, so next build inside the container
# REQUIRES them — a previous version ignored them and broke docker builds the
# same way .vercelignore once stripped png/svg from Vercel deployments.
*.pdf
*.log
